{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Folduct: read and move files only inside folders the user picked (runtime fs scope). No remove/write permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-mkdir"
  ]
}
